# W4 dot-on-rod 3D length: renders (scripts/46_dotrod_3d_length.py writes the inputs).
# Run offscreen as a CPU job:  $CHIMERAX --nogui --offscreen --silent scripts/46_dotrod_render_fit.cxc
# Display maps are the 12 A low-passed maps, principal-axis aligned (x = longest, z = thinnest axis), scaled so
# level 1.0 = the primary contour (main component encloses 65,000 A^3). Green = compact lobe segment, blue = rod,
# orange/magenta/... markers = medial skeleton branches. v1 looks down z (widest view), v2 down x, v3 down y.
log clear
set bgColor white
lighting soft
graphics silhouettes true width 1.5
# ---- nu
close
open /n/netscratch/hekstra_lab/Lab/ian_poon/sfgfp_chimera_screening_20261112/dotrod_3d_length/disp_nu_lobe.mrc
open /n/netscratch/hekstra_lab/Lab/ian_poon/sfgfp_chimera_screening_20261112/dotrod_3d_length/disp_nu_rod.mrc
open /n/netscratch/hekstra_lab/Lab/ian_poon/sfgfp_chimera_screening_20261112/dotrod_3d_length/disp_nu_skel.cmm
volume #1 level 1.0 style surface color #3cb44b step 1
volume #2 level 1.0 style surface color #5b8fd9 step 1
transparency #1,2 30
view orient
view
save /n/home05/ianpoon/DNA-springs-project-2026-27/cryoEM/sfgfp_chimera_screening/figures/maps/dotrod_nu_v1.png width 800 height 650 supersample 2
turn y 90
view
save /n/home05/ianpoon/DNA-springs-project-2026-27/cryoEM/sfgfp_chimera_screening/figures/maps/dotrod_nu_v2.png width 800 height 650 supersample 2
view orient
turn x -90
view
save /n/home05/ianpoon/DNA-springs-project-2026-27/cryoEM/sfgfp_chimera_screening/figures/maps/dotrod_nu_v3.png width 800 height 650 supersample 2
