source leaprc.protein.ff14SB
source leaprc.DNA.OL15
source leaprc.water.tip3p
source leaprc.xFPchromophores
loadamberparams frcmod.ions234lm_126_tip3p
loadamberparams gaff2.dat
loadamberparams TDP.frcmod
loadamberparams DNL.frcmod
loadamberparams DNP.frcmod
loadamberparams junction.frcmod
loadamberprep TDP.prepin
loadamberprep DNL.prepin
loadamberprep DNP.prepin
mol = loadpdb chimera_loop50.pdb
bond mol.131@CN mol.232@N
bond mol.147@CN mol.283@N

solvateoct mol TIP3PBOX 12.0
quit
